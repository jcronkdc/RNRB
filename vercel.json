{
  "buildCommand": "pnpm turbo run build",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "rootDirectory": "apps/web",
  "regions": ["iad1"],
  "functions": {
    "app/api/ai-lyrics/route.ts": {
      "maxDuration": 60
    },
    "app/api/trpc/[trpc]/route.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  }
}

