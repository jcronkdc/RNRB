{
  "extends": "@songforge/config/tsconfig/next",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.ts",
    ".next/types/**/*.ts",
    "tailwind.config.ts",
    "postcss.config.mjs"
  ],
  "exclude": [
    "node_modules"
  ]
}
