{
  "name": "@rnrb/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "pnpm --filter @cronkwaters/db run build && next build",
    "build:analyze": "ANALYZE=true pnpm build",
    "build:prod": "NODE_ENV=production pnpm build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "fix": "pnpm lint:fix && pnpm format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:routes": "npx tsx scripts/validate-routes.ts",
    "validate:icons": "npx tsx scripts/validate-icons.ts",
    "validate": "pnpm validate:routes && pnpm validate:icons",
    "prebuild": "pnpm validate:icons",
    "bundle:analyze": "ANALYZE=true pnpm build && open bundle-report.html",
    "bundle:size": "pnpm build && du -sh .next",
    "lighthouse": "lighthouse https://www.cronkwaters.com/social/explore --output json --output html --output-path ./lighthouse-report.html"
  },
  "dependencies": {
    "@cronkwaters/auth": "workspace:*",
    "@cronkwaters/db": "workspace:*",
    "@cronkwaters/trpc": "workspace:*",
    "@cronkwaters/ui": "workspace:*",
    "@daily-co/daily-js": "^0.85.0",
    "@daily-co/daily-react": "^0.24.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@mux/mux-node": "^12.8.0",
    "@mux/mux-player-react": "^3.2.2",
    "@next/bundle-analyzer": "^15.5.2",
    "@prisma/client": "^5.20.0",
    "@react-email/components": "^1.0.1",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.81.1",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-virtual": "^3.5.0",
    "@trpc/client": "^11.0.0-rc.502",
    "@trpc/react-query": "^11.0.0-rc.502",
    "@trpc/server": "^11.0.0-rc.502",
    "@types/bcryptjs": "^3.0.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/blob": "^2.0.0",
    "@vercel/sdk": "^1.17.7",
    "ably": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.0.5",
    "jotai": "^2.15.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.344.0",
    "next": "^15.5.3",
    "next-auth": "5.0.0-beta.30",
    "nodemailer": "^7.0.11",
    "openai": "^6.9.1",
    "postcss": "^8.4.48",
    "posthog-js": "^1.298.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.5.2",
    "stripe": "^17.4.0",
    "superjson": "^2.2.1",
    "swr": "^2.3.6",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "web-push": "^3.6.7",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cronkwaters/config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/nodemailer": "^6.4.21",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "jsdom": "^26.0.0",
    "msw": "^2.7.3",
    "sharp": "^0.34.5",
    "vitest": "^4.0.8"
  },
  "browserslist": {
    "production": [
      "chrome >= 92",
      "edge >= 92",
      "firefox >= 90",
      "safari >= 15.4",
      "ios >= 15.4",
      "not dead",
      "not op_mini all",
      "not ie 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
