{
  "extends": "@cronkwaters/config/tsconfig/base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@cronkwaters/ui": ["packages/ui/src/index"],
      "@cronkwaters/ui/*": ["packages/ui/src/*"],
      "@cronkwaters/db": ["packages/db/src/index"],
      "@cronkwaters/auth": ["packages/auth/src/index"],
      "@cronkwaters/trpc": ["packages/trpc/src/index"],
      "@cronkwaters/trpc/*": ["packages/trpc/src/*"]
    }
  },
  "include": ["packages", "apps", "turbo.json"]
}
