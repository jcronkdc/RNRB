{
  "extends": "@cronkwater/config/tsconfig/base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@cronkwater/ui": ["packages/ui/src/index"],
      "@cronkwater/ui/*": ["packages/ui/src/*"],
      "@cronkwater/db": ["packages/db/src/index"],
      "@cronkwater/auth": ["packages/auth/src/index"],
      "@cronkwater/trpc": ["packages/trpc/src/index"],
      "@cronkwater/trpc/*": ["packages/trpc/src/*"]
    }
  },
  "include": ["packages", "apps", "turbo.json"]
}
