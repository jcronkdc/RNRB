{
  "name": "rnrb",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "cd packages/db && prisma generate && cd ../.. && turbo run build",
    "start": "turbo run start",
    "prisma:generate": "cd packages/db && prisma generate",
    "prisma:studio": "cd packages/db && prisma studio",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@cronkwaters/auth": "workspace:*",
    "@cronkwaters/db": "workspace:*",
    "@cronkwaters/trpc": "workspace:*",
    "@cronkwaters/ui": "workspace:*",
    "@daily-co/daily-js": "^0.85.0",
    "@daily-co/daily-react": "^0.24.0",
    "@prisma/client": "^5.22.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.81.1",
    "@tanstack/react-query": "^5.62.7",
    "@trpc/client": "^11.0.0-rc.502",
    "@trpc/react-query": "^11.0.0-rc.502",
    "@trpc/server": "^11.0.0-rc.502",
    "ably": "^2.0.0",
    "framer-motion": "^11.0.5",
    "lucide-react": "^0.344.0",
    "next": "^15.0.0",
    "next-auth": "4.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "superjson": "^2.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cronkwaters/config": "workspace:*",
    "@rollup/rollup-darwin-arm64": "4.53.2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.0.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "postcss": "^8.4.48",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "turbo": "^2.6.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.8"
  }
}
