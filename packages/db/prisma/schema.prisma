generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  image             String?
  pro               String?  // ASCAP, BMI, SESAC, None
  mlcMember         Boolean  @default(false)
  soundExchangeRegistered Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  memberships       Membership[]
  subscriptions    Subscription[]

  @@index([email])
}

model Org {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  type        OrgType
  brandColor  String?       // Hex color
  description String?
  website     String?
  bio         String?       // Extended biography
  location    String?       // City, State/Country
  genre       String[]      // Musical genres
  influences  String[]      // Musical influences
  founded     Int?          // Year founded
  socialLinks Json?         // { twitter, instagram, facebook, youtube, tiktok, etc }
  contactEmail String?
  bookingEmail String?
  pressKitUrl String?       // Link to downloadable press kit
  epkData     Json?         // Electronic Press Kit data
  achievements Json?        // Notable achievements/milestones
  spotifyArtistId String?
  appleMusicId String?
  images      Json?         // { hero, profile, gallery: [...] }
  verified    Boolean      @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  memberships Membership[]
  projects    Project[]     @relation(name: "OrgProjects")
  events      Event[]
  episodes    PodcastEpisode[]
  tours       Tour[]
  shows       Show[]
  bandMembers BandMember[]
  pressReleases PressRelease[]
  awards      Award[]

  @@index([slug])
  @@index([type])
  @@index([genre])
  @@index([location])
}

model Membership {
  userId    String
  orgId     String
  role      OrgRole
  user      User @relation(fields: [userId], references: [id])
  org       Org  @relation(fields: [orgId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, orgId])
  @@index([orgId])
}

enum OrgType {
  foundation
  studio
  band
}

enum OrgRole {
  owner
  admin
  member
}

model Project {
  id          String             @id @default(cuid())
  orgId       String
  name        String
  slug        String             @unique
  description String?
  tagline     String?
  coverImage  String?
  visibility  ProjectVisibility  @default(private)
  status      ProjectStatus      @default(active)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  org         Org                @relation(fields: [orgId], references: [id], name: "OrgProjects")
  songs       Song[]
  assets      Asset[]
  splitSheets SplitSheet[]
  licenses    License[]
  events      Event[]
  shows       Show[]

  @@index([orgId])
  @@index([slug])
  @@index([visibility, status])
}

enum ProjectVisibility {
  private
  org
  public
}

enum ProjectStatus {
  active
  archived
  draft
}

model Song {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  key         String?
  tempo       Int?
  timeSignature String? // e.g., "4/4", "3/4"
  iswc        String?  @unique // International Standard Musical Work Code
  description String?
  lyrics      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  setlistItems SetlistItem[]

  @@index([projectId])
  @@index([iswc])
}

model Asset {
  id            String      @id @default(cuid())
  projectId     String?
  name          String
  mimeType      String
  bytes         BigInt      // File size in bytes
  storageKey    String      @unique // S3/R2 key
  storageBucket String?
  checksum      String      // SHA-256
  duration      Float?      // For audio/video, in seconds
  sampleRate    Int?        // For audio, in Hz
  width         Int?        // For images/video
  height        Int?        // For images/video
  metadata      Json?       // Additional extracted metadata
  assetType     AssetType
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  project       Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assetType])
  @@index([storageKey])
  @@index([checksum])
}

enum AssetType {
  audio
  lyric
  image
  pdf
  chart
  video
  other
}

model SplitSheet {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  finalized   Boolean          @default(false)
  finalizedAt DateTime?
  pdfKey      String?          // Storage key for generated PDF
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contributors SplitContributor[]

  @@index([projectId])
  @@index([finalized])
}

model SplitContributor {
  id          String     @id @default(cuid())
  splitSheetId String
  name        String
  role        String?    // e.g., "Writer", "Producer", "Publisher"
  percentage  Float      // 0-100
  pro         String?    // ASCAP, BMI, SESAC, etc.
  ipi         String?    // International Performer Identification
  publisher   String?
  email       String?
  finalized   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  splitSheet  SplitSheet @relation(fields: [splitSheetId], references: [id], onDelete: Cascade)

  @@index([splitSheetId])
}

model License {
  id            String        @id @default(cuid())
  projectId     String
  template      LicenseTemplate
  title         String
  terms         String?       // Custom terms override
  notes         String?
  status        LicenseStatus @default(draft)
  signedAt      DateTime?
  countersignedAt DateTime?
  pdfKey        String?       // Storage key for signed PDF
  signerEmail   String?
  signerName    String?
  countersignerEmail String?
  countersignerName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([template])
}

enum LicenseTemplate {
  COLLAB_NDA
  WORK_FOR_HIRE
  NON_EXCLUSIVE_COLLAB
  PODCAST_MUSIC_LICENSE
  EXCLUSIVE_LICENSE
  MASTER_USE
  SYNCHRONIZATION
}

enum LicenseStatus {
  draft
  pending_signature
  pending_countersignature
  executed
  expired
  cancelled
}

model Event {
  id          String      @id @default(cuid())
  projectId   String?
  orgId       String?
  name        String
  slug        String      @unique
  description String?
  eventType   EventType
  startDate   DateTime
  endDate     DateTime?
  venue       String?
  venueAddress String?
  city        String?
  state       String?
  country     String?
  lineup      Json?       // Array of artist/band names
  ticketUrl   String?
  coverImage  String?
  public      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  org         Org?        @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId])
  @@index([eventType])
  @@index([startDate])
  @@index([slug])
}

enum EventType {
  festival
  concert
  showcase
  workshop
  other
}

model PodcastEpisode {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  slug        String   @unique
  description String?
  showNotes   String?  // Markdown
  audioKey    String?  // Storage key for audio file
  duration    Float?   // In seconds
  publishedAt DateTime?
  guests      Json?    // Array of { name, role, bio }
  tags        String[] // Array of tags
  public      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([publishedAt])
  @@index([slug])
  @@index([public])
}

model Donation {
  id            String         @id @default(cuid())
  amount        Decimal        // In dollars
  currency      String         @default("USD")
  donorName     String?
  donorEmail    String?
  donorAnonymous Boolean       @default(false)
  message       String?
  paymentId     String?       // Give Lively/Stripe payment ID
  status        DonationStatus @default(pending)
  processedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([paymentId])
}

enum DonationStatus {
  pending
  completed
  failed
  refunded
}


enum SubscriptionTier {
  sustaining
  patron
  benefactor
}

enum SubscriptionStatus {
  active
  cancelled
  past_due
  trialing
  incomplete
}

model Subscription {
  id            String           @id @default(cuid())
  userId        String?
  email         String
  tier          SubscriptionTier
  amount        Decimal          // Monthly amount
  currency      String           @default("USD")
  stripeId      String?         @unique // Stripe subscription ID
  status        SubscriptionStatus @default(active)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean     @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User?            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([stripeId])
}

// Tour Management Models

model Tour {
  id            String     @id @default(cuid())
  orgId         String
  name          String
  slug          String     @unique
  description   String?
  startDate     DateTime
  endDate       DateTime?
  status        TourStatus @default(planning)
  posterImage   String?
  sponsorLogos  Json?      // Array of { name, logoUrl, website }
  merch         Json?      // Array of { name, price, image, url }
  public        Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  org           Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shows         Show[]
  fanEngagements FanEngagement[]

  @@index([orgId])
  @@index([status])
  @@index([startDate])
}

enum TourStatus {
  planning
  announced
  ongoing
  completed
  cancelled
}

model Venue {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  type              VenueType @default(club)
  capacity          Int?
  address           String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  latitude          Float?
  longitude         Float?
  phone             String?
  email             String?
  website           String?
  parkingInfo       String?
  accessibilityInfo String?
  images            Json?     // Array of image URLs
  socialLinks       Json?     // { twitter, instagram, facebook, etc }
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  shows             Show[]

  @@index([city])
  @@index([type])
}

enum VenueType {
  club
  theater
  arena
  stadium
  festival
  other
}

model Show {
  id              String      @id @default(cuid())
  tourId          String?
  orgId           String
  projectId       String?
  venueId         String?
  name            String
  slug            String      @unique
  description     String?
  date            DateTime
  doorsTime       DateTime?
  soundcheckTime  DateTime?
  setLength       Int?        // In minutes
  status          ShowStatus  @default(scheduled)
  ticketUrl       String?
  ticketPrice     Json?       // { general: 25, vip: 50, etc }
  ageRestriction  String?
  supportingActs  Json?       // Array of { name, website, setTime }
  notes           String?     // Internal notes
  posterImage     String?
  livestreamUrl   String?
  recordingUrl    String?
  attendance      Int?
  grossRevenue    Decimal?
  public          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  tour            Tour?       @relation(fields: [tourId], references: [id], onDelete: SetNull)
  org             Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project         Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  venue           Venue?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  setlist         Setlist?
  fanEngagements  FanEngagement[]

  @@index([tourId])
  @@index([orgId])
  @@index([venueId])
  @@index([date])
  @@index([status])
}

enum ShowStatus {
  scheduled
  soldout
  cancelled
  postponed
  completed
}

model Setlist {
  id          String         @id @default(cuid())
  showId      String         @unique
  name        String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  show        Show           @relation(fields: [showId], references: [id], onDelete: Cascade)
  items       SetlistItem[]
}

model SetlistItem {
  id          String    @id @default(cuid())
  setlistId   String
  songId      String?
  position    Int
  notes       String?
  duration    Int?      // In seconds
  isEncore    Boolean   @default(false)
  customTitle String?   // For covers or unreleased songs
  
  setlist     Setlist   @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  song        Song?     @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([setlistId])
  @@index([songId])
}

model FanEngagement {
  id           String    @id @default(cuid())
  showId       String?
  tourId       String?
  email        String
  name         String?
  notifyShows  Boolean   @default(true)
  notifyMerch  Boolean   @default(false)
  location     String?   // City/State for tour routing
  createdAt    DateTime  @default(now())
  
  show         Show?     @relation(fields: [showId], references: [id], onDelete: SetNull)
  tour         Tour?     @relation(fields: [tourId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([showId])
  @@index([tourId])
}

model BandMember {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  role        String    // e.g., "Lead Vocals", "Guitar", "Drums"
  bio         String?
  image       String?
  instruments String[]
  socialLinks Json?     // { twitter, instagram, etc }
  joinedAt    DateTime?
  active      Boolean   @default(true)
  order       Int       @default(0) // Display order
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model PressRelease {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  slug        String    @unique
  content     String    // Markdown content
  excerpt     String?
  publishedAt DateTime?
  attachments Json?     // Array of { name, url, type }
  public      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([publishedAt])
}

model Award {
  id              String    @id @default(cuid())
  orgId           String
  name            String    // e.g., "Grammy Award"
  organization    String    // e.g., "The Recording Academy"
  year            Int
  category        String?   // e.g., "Best New Artist"
  description     String?
  image           String?
  verificationUrl String?
  createdAt       DateTime  @default(now())
  
  org             Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([year])
}
