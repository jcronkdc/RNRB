generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "darwin", "rhel-openssl-3.0.x"]
  // FORCE REGENERATION - added darwin target: 2025-12-01
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // For 1000+ concurrent users, use Neon's connection pooler
  // directUrl is used for migrations, url uses PgBouncer pooler
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  emailVerified           DateTime?
  password                String? // For password-based authentication
  name                    String?
  image                   String?
  pro                     String?
  isOwner                 Boolean   @default(false) // Platform owner - bypasses ALL limits
  mlcMember               Boolean   @default(false)
  soundExchangeRegistered Boolean   @default(false)
  profileCompleted        Boolean   @default(false) // Track if user has completed profile setup
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Stripe Subscription Fields
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripeConnectAccountId String?   @unique // For artist payouts via Stripe Connect
  subscriptionTier       String    @default("free") // free, creator, studio
  subscriptionStatus     String? // active, canceled, past_due, trialing, incomplete
  subscriptionStartedAt  DateTime?
  subscriptionEndsAt     DateTime?
  subscriptionCanceledAt DateTime?
  subscriptionRenewsAt   DateTime?

  // Usage Tracking Fields (Protects profit margins)
  aiRequestsUsed             Int       @default(0)
  videoMinutesUsed           Int       @default(0)
  assistantConversationsUsed Int       @default(0) // For AI Assistant add-on
  imageCreditsUsed           Int       @default(0) // AI album art generation
  usagePeriodStart           DateTime? @default(now())
  storageUsedGB              Decimal   @default(0) @db.Decimal(10, 2)

  // Usage Bonus Buckets (top-ups)
  aiRequestsBonus   Int     @default(0)
  videoMinutesBonus Int     @default(0)
  imageCreditsBonus Int     @default(0) // Purchased image credit packs
  storageBonusGB    Decimal @default(0) @db.Decimal(10, 2)

  accounts               Account[]
  sessions               Session[]
  uploadedAssets         Asset[]
  assetShares            AssetShare[]
  collaborationRequests  CollaborationRequest[]
  collaborationResponses CollaborationResponse[]
  comments               Comment[]
  connectedTo            Connection[]            @relation("ConnectedToUser")
  connections            Connection[]            @relation("UserConnections")
  forumPosts             ForumPost[]
  forumReplies           ForumReply[]
  memberships            Membership[]
  receivedMessages       Message[]               @relation("ReceivedMessages")
  sentMessages           Message[]               @relation("SentMessages")
  musicianProfile        MusicianProfile?
  orgInvites             OrgInvite[]
  sessionAttendances     SessionAttendee[]
  skills                 Skill[]
  songSplits             SongSplit[]
  studioSessions         StudioSession[]
  subscriptions          Subscription[]
  songs                  Song[] // Owned songs
  songCollaborations     SongCollaborator[] // Songs shared with user
  sentInvitations        Invitation[]            @relation("SentInvitations")
  receivedInvitations    Invitation[]            @relation("ReceivedInvitations")
  projectMemberships     ProjectMember[]
  setlistTemplates       SetlistTemplate[]
  passwordResetTokens    PasswordResetToken[]

  // Community Features
  communityTracks CommunityTrack[]
  trackLikes      TrackLike[]
  trackPlays      TrackPlay[]
  trackComments   TrackComment[]
  followers       UserFollow[]     @relation("UserFollowers")
  following       UserFollow[]     @relation("UserFollowing")
  songVersions    SongVersion[]
  uploadedTracks  SongTrack[]

  // Project Management
  createdMilestones ProjectMilestone[] @relation("CreatedMilestones")
  createdViews      ProjectView[]      @relation("CreatedViews")
  createdReferences ProjectReference[] @relation("CreatedReferences")

  // Notifications
  notifications     Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("NotificationActor")

  // Library Files & Collections
  libraryFiles       LibraryFile[]
  libraryCollections LibraryCollection[]
  sharedFiles        LibraryFileShare[]  @relation("SharedByUser")
  receivedShares     LibraryFileShare[]  @relation("SharedWithUser")

  // AI Assistant
  assistantConversations AssistantConversation[]
  aiMemories             AIMemory[]
  conversationSummaries  ConversationSummary[]
  creditPurchases        CreditPurchase[]

  // Website Builder
  musicianSite MusicianSite?

  // R&R Labs Research
  labsVolunteer LabsVolunteer?

  // Musician's Toolbox - Mycelial Integration
  gearItems        GearItem[]
  practiceSessions PracticeSession[]
  practiceGoals    PracticeGoal[]
  recordingNotes   RecordingNote[]

  // Social Feed
  authoredPosts        Post[]                @relation("AuthoredPosts")
  sharedPosts          Post[]                @relation("SharedPosts")
  postReactions        PostReaction[]        @relation("PostReactions")
  postShares           PostShare[]           @relation("UserPostShares")
  postComments         PostComment[]         @relation("PostComments")
  postCommentReactions PostCommentReaction[] @relation("PostCommentReactions")
  postPlays            PostPlay[]            @relation("PostPlays")
  postBookmarks        PostBookmark[]        @relation("PostBookmarks")

  // Ecosystem - Living Network
  collaborationNeeds   CollaborationNeed[]
  collaborationApps    CollaborationApplication[]
  postedOpportunities  Opportunity[]
  opportunityApps      OpportunityApplication[]
  activities           ActivityEvent[]            @relation("UserActivity")
  activityCelebrations ActivityCelebration[]
  revenues             Revenue[]

  // Masterclass Feature
  instructorProfile      MasterclassInstructor?
  masterclassEnrollments MasterclassEnrollment[]
  masterclassReviews     MasterclassReview[]

  // Affiliate/Streamer System
  affiliate          Affiliate?
  affiliateReferrals AffiliateReferral[]

  // Marketplace
  marketplaceProfile          MarketplaceProfile? // User verification & reputation
  marketplaceListings         MarketplaceListing[]        @relation("MarketplaceListings")
  marketplaceFavorites        MarketplaceFavorite[]       @relation("MarketplaceFavorites")
  marketplaceOffers           MarketplaceOffer[]          @relation("MarketplaceOffers")
  marketplaceMessagesSent     MarketplaceMessage[]        @relation("MarketplaceMessagesSent")
  marketplaceMessagesReceived MarketplaceMessage[]        @relation("MarketplaceMessagesReceived")
  marketplaceAlerts           MarketplaceAlert[]          @relation("MarketplaceAlerts")
  marketplaceWanted           MarketplaceWanted[]         @relation("MarketplaceWanted")
  marketplaceWantedResponses  MarketplaceWantedResponse[] @relation("MarketplaceWantedResponses")
  marketplaceReports          MarketplaceReport[]         @relation("MarketplaceReports")

  // Platform Merch Store Orders
  platformMerchOrders PlatformMerchOrder[] @relation("PlatformMerchOrders")

  // Artist Merch Store (Multi-tenant POD)
  artistMerchProducts         ArtistMerchProduct[]   @relation("ArtistMerchProducts")
  artistMerchOrdersAsCustomer ArtistMerchOrder[]     @relation("ArtistMerchOrdersAsCustomer")
  artistMerchOrderItems       ArtistMerchOrderItem[] @relation("ArtistMerchOrderItems")
  artistMerchPayouts          ArtistMerchPayout[]    @relation("ArtistMerchPayouts")

  // RNRB Mail - Professional Email Service
  emailAccount           EmailAccount?
  emailTier              EmailTier     @default(NONE) // none, basic (paid members), pro ($3/mo add-on)
  emailProSubscriptionId String?       @unique // Stripe subscription for Email Pro add-on
  emailProStatus         String? // active, canceled, past_due
  emailAccountsLimit     Int           @default(0) // 0 = no access, 1 = basic, -1 = unlimited (pro)
  emailStorageQuotaBytes BigInt        @default(0) // 0 = no access, 1GB = basic, 10GB = pro

  @@index([email])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([subscriptionStatus])
  @@index([subscriptionTier])
  @@index([usagePeriodStart])
}

model Org {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  type             OrgType
  brandColor       String?
  description      String?
  website          String?
  bio              String?
  location         String?
  genre            String[]
  influences       String[]
  founded          Int?
  socialLinks      Json?
  contactEmail     String?
  bookingEmail     String?
  pressKitUrl      String?
  epkData          Json?
  achievements     Json?
  spotifyArtistId  String?
  appleMusicId     String?
  images           Json?
  verified         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  awards           Award[]
  bandMembers      BandMember[]
  events           Event[]
  memberships      Membership[]
  orgInvites       OrgInvite[]
  episodes         PodcastEpisode[]
  pressReleases    PressRelease[]
  projects         Project[]         @relation("OrgProjects")
  shows            Show[]
  tours            Tour[]
  invitations      Invitation[]
  setlistTemplates SetlistTemplate[]
  musicianSites    MusicianSite[]

  // Ecosystem Integration
  opportunities Opportunity[]

  @@index([slug])
  @@index([type])
  @@index([genre])
  @@index([location])
}

model Membership {
  userId    String
  orgId     String
  role      OrgRole
  status    String   @default("active")
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, orgId])
  @@index([orgId])
}

model Project {
  id             String             @id @default(cuid())
  orgId          String
  name           String
  slug           String             @unique
  description    String?
  tagline        String?
  coverImage     String?
  visibility     ProjectVisibility  @default(private)
  status         ProjectStatus      @default(active)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  assets         Asset[]
  events         Event[]
  licenses       License[]
  org            Org                @relation("OrgProjects", fields: [orgId], references: [id])
  shows          Show[]
  songs          Song[]
  splitSheets    SplitSheet[]
  studioSessions StudioSession[]
  transactions   Transaction[]
  invitations    Invitation[]
  members        ProjectMember[]
  milestones     ProjectMilestone[] // Timeline & roadmap
  views          ProjectView[] // Smart folders & filters
  references     ProjectReference[] // Mood boards & inspiration
  insights       ProjectInsight? // AI analysis

  // Toolbox Integration
  recordingNotes RecordingNote[] // Recording notes for this project

  // Ecosystem Integration
  collaborationNeeds CollaborationNeed[]
  activities         ActivityEvent[]
  revenues           Revenue[]
  featuredOnProfiles MusicianProfile[]   @relation("FeaturedProject")

  @@index([orgId])
  @@index([slug])
  @@index([visibility, status])
}

model Song {
  id            String     @id @default(cuid())
  userId        String // Owner of the song
  projectId     String? // Optional - songs can be standalone
  title         String
  writer        String? // Primary writer
  coWriters     String?    @db.Text // JSON array of co-writer names
  dateWritten   String? // Flexible format (2024, Spring 2023, etc.)
  status        SongStatus @default(draft)
  tags          String?    @db.Text // JSON array of tags (Setlist, Open Mic, etc.)
  album         String? // Legacy/optional grouping
  archived      Boolean    @default(false)
  visibility    Visibility @default(private)
  key           String?
  tempo         Int?
  timeSignature String?
  iswc          String?    @unique
  isrc          String? // International Standard Recording Code
  description   String?
  lyrics        String?    @db.Text
  chords        String?    @db.Text // JSON array of ChordPosition objects
  lastSavedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Copyright & Publishing Information
  copyrightInfo Json? // Copyright, PRO, splits, publishing details
  audioUrl      String? // URL to uploaded audio file
  audioPath     String? // Storage path for audio

  // AI-Generated Artwork
  artworkUrl    String? // URL to generated/uploaded artwork
  artworkPrompt String? // Prompt used for AI generation (for regeneration)
  artworkStyle  String? // Style preset used (e.g., "vinyl-classic", "neon-glow")

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  setlistItems   SetlistItem[]
  songSplits     SongSplit[]
  transactions   Transaction[]
  collaborators  SongCollaborator[]
  communityTrack CommunityTrack? // Song published to community
  versions       SongVersion[] // Version history
  tracks         SongTrack[] // Multi-track stems

  // Toolbox Integration
  practiceSessions PracticeSession[] // Practice sessions for this song
  recordingNotes   RecordingNote[] // Recording notes for this song

  // Ecosystem Integration
  collaborationNeeds CollaborationNeed[]
  activities         ActivityEvent[]
  revenues           Revenue[]
  featuredOnProfiles MusicianProfile[]   @relation("FeaturedSong")

  @@index([userId])
  @@index([projectId])
  @@index([iswc])
  @@index([status])
  @@index([archived])
  @@index([visibility])
}

enum SongStatus {
  draft
  in_progress
  needs_review
  complete
}

enum Visibility {
  private
  org
  public
}

model SongCollaborator {
  id         String    @id @default(cuid())
  songId     String
  userId     String? // If registered user
  email      String? // If invited by email
  role       String    @default("collaborator") // collaborator, co-writer, etc.
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  song Song  @relation(fields: [songId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@unique([songId, email])
  @@index([songId])
  @@index([userId])
}

// ====================================
// VERSION CONTROL - Time Machine for Music
// ====================================
model SongVersion {
  id          String  @id @default(cuid())
  songId      String
  versionNum  Int // v1, v2, v3...
  label       String? // "Demo", "Final Mix", "Radio Edit", "Acoustic Version"
  description String? // "Added bridge, changed chorus melody"

  // Snapshot of song state at this version
  title         String
  lyrics        String? @db.Text
  chords        String? @db.Text
  key           String?
  tempo         Int?
  timeSignature String?
  audioUrl      String? // Audio snapshot for this version
  audioPath     String?

  // Metadata
  createdById String
  createdAt   DateTime @default(now())
  isPublished Boolean  @default(false) // Is this the "live" version?

  song      Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@unique([songId, versionNum])
  @@index([songId, versionNum])
  @@index([createdAt])
}

// ====================================
// STEMS & MULTI-TRACK MANAGEMENT
// ====================================
model SongTrack {
  id        String    @id @default(cuid())
  songId    String
  versionId String? // Optional: Link to specific version
  trackName String // "Lead Vocal", "Bass", "Drums", "Guitar"
  trackType TrackType

  // Audio file
  audioUrl  String
  audioPath String
  duration  Float? // Duration in seconds

  // Waveform data for visualization
  waveformData Json? // Array of amplitude values

  // Mixing parameters
  volume Float   @default(1.0) // 0.0 to 2.0
  pan    Float   @default(0.0) // -1.0 (left) to 1.0 (right)
  solo   Boolean @default(false)
  mute   Boolean @default(false)

  // Track organization
  order Int
  color String? // Hex color for UI

  // Metadata
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  song       Song  @relation(fields: [songId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([songId, order])
  @@index([trackType])
}

enum TrackType {
  vocal_lead
  vocal_harmony
  vocal_backing
  guitar_electric
  guitar_acoustic
  guitar_bass
  drums
  percussion
  piano
  synth
  strings
  brass
  woodwind
  fx
  master
  other
}

model Asset {
  id            String       @id @default(cuid())
  projectId     String?
  name          String
  mimeType      String
  fileType      String?
  bytes         BigInt
  size          Int?
  version       Int          @default(1)
  storageKey    String       @unique
  storageBucket String?
  checksum      String
  duration      Float?
  sampleRate    Int?
  width         Int?
  height        Int?
  metadata      Json?
  assetType     AssetType
  uploadedAt    DateTime     @default(now())
  uploadedById  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project?     @relation(fields: [projectId], references: [id])
  uploadedBy    User?        @relation(fields: [uploadedById], references: [id])
  assetShares   AssetShare[]

  @@index([projectId])
  @@index([assetType])
  @@index([storageKey])
  @@index([checksum])
  @@index([uploadedById])
}

model SplitSheet {
  id           String             @id @default(cuid())
  projectId    String
  title        String
  finalized    Boolean            @default(false)
  finalizedAt  DateTime?
  pdfKey       String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  contributors SplitContributor[]
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([finalized])
}

model SplitContributor {
  id           String     @id @default(cuid())
  splitSheetId String
  name         String
  role         String?
  percentage   Float
  pro          String?
  ipi          String?
  publisher    String?
  email        String?
  finalized    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  splitSheet   SplitSheet @relation(fields: [splitSheetId], references: [id], onDelete: Cascade)

  @@index([splitSheetId])
}

model License {
  id                 String          @id @default(cuid())
  projectId          String
  template           LicenseTemplate
  title              String
  terms              String?
  notes              String?
  status             LicenseStatus   @default(draft)
  signedAt           DateTime?
  countersignedAt    DateTime?
  pdfKey             String?
  signerEmail        String?
  signerName         String?
  countersignerEmail String?
  countersignerName  String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([template])
}

model Event {
  id           String    @id @default(cuid())
  projectId    String?
  orgId        String?
  name         String
  slug         String    @unique
  description  String?
  eventType    EventType
  startDate    DateTime
  endDate      DateTime?
  venue        String?
  venueAddress String?
  city         String?
  state        String?
  country      String?
  lineup       Json?
  ticketUrl    String?
  coverImage   String?
  public       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  org          Org?      @relation(fields: [orgId], references: [id])
  project      Project?  @relation(fields: [projectId], references: [id])

  @@index([orgId])
  @@index([projectId])
  @@index([eventType])
  @@index([startDate])
  @@index([slug])
}

model PodcastEpisode {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  slug        String    @unique
  description String?
  showNotes   String?
  audioKey    String?
  duration    Float?
  publishedAt DateTime?
  guests      Json?
  tags        String[]
  public      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([publishedAt])
  @@index([slug])
  @@index([public])
}

model Donation {
  id             String         @id @default(cuid())
  amount         Decimal
  currency       String         @default("USD")
  donorName      String?
  donorEmail     String?
  donorAnonymous Boolean        @default(false)
  message        String?
  paymentId      String?
  status         DonationStatus @default(pending)
  processedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([paymentId])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String?
  email              String
  tier               SubscriptionTier
  amount             Decimal
  currency           String             @default("USD")
  stripeId           String?            @unique
  status             SubscriptionStatus @default(active)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User?              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([stripeId])
}

model Tour {
  id             String          @id @default(cuid())
  orgId          String
  name           String
  slug           String          @unique
  description    String?
  startDate      DateTime
  endDate        DateTime?
  status         TourStatus      @default(planning)
  posterImage    String?
  sponsorLogos   Json?
  merch          Json?
  public         Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  fanEngagements FanEngagement[]
  shows          Show[]
  org            Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Ecosystem Integration
  activities ActivityEvent[]

  @@index([orgId])
  @@index([status])
  @@index([startDate])
}

model Venue {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  type              VenueType @default(club)
  capacity          Int?
  address           String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  latitude          Float?
  longitude         Float?
  phone             String?
  email             String?
  website           String?
  parkingInfo       String?
  accessibilityInfo String?
  images            Json?
  socialLinks       Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  shows             Show[]

  // Ecosystem Integration
  opportunities Opportunity[]

  @@index([city])
  @@index([type])
}

model Show {
  id             String          @id @default(cuid())
  tourId         String?
  orgId          String
  projectId      String?
  venueId        String?
  name           String
  slug           String          @unique
  description    String?
  date           DateTime
  loadInTime     DateTime?
  soundcheckTime DateTime?
  doorsTime      DateTime?
  setTime        DateTime?
  setLength      Int?
  status         ShowStatus      @default(scheduled)
  ticketUrl      String?
  ticketPrice    Json?
  ageRestriction String?
  supportingActs Json?
  notes          String?
  backstageNotes String?
  posterImage    String?
  livestreamUrl  String?
  recordingUrl   String?
  attendance     Int?
  public         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  fanEngagements FanEngagement[]
  setlist        Setlist?
  org            Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id])
  tour           Tour?           @relation(fields: [tourId], references: [id])
  venue          Venue?          @relation(fields: [venueId], references: [id])

  // Ecosystem Integration
  activities ActivityEvent[]
  revenues   Revenue[]

  @@index([tourId])
  @@index([orgId])
  @@index([venueId])
  @@index([date])
  @@index([status])
}

model Setlist {
  id           String        @id @default(cuid())
  showId       String        @unique
  name         String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  show         Show          @relation(fields: [showId], references: [id], onDelete: Cascade)
  items        SetlistItem[]
  songRequests SongRequest[]
}

model SetlistItem {
  id          String  @id @default(cuid())
  setlistId   String
  songId      String?
  position    Int
  notes       String?
  duration    Int?
  isEncore    Boolean @default(false)
  customTitle String?
