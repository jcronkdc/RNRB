model SiteSection {
  id     String  @id @default(cuid())
  siteId String
  pageId String? // Which page (null = global like header/footer)

  // Section type
  type SectionType

  // Content (varies by section type)
  // Hero: { title, subtitle, backgroundImage, backgroundVideo, ctaText, ctaLink }
  // Music: { autoSync: true, trackIds: [], spotifyEmbed, appleMusicEmbed }
  // Tour: { autoSync: true, showIds: [], showMap: true }
  // Bio: { content: "rich text", images: [] }
  // Gallery: { images: [], layout: "masonry" | "grid" }
  // Contact: { fields: [], submitTo: "email" | "webhook" }
  // MailingList: { provider: "native" | "mailchimp", listId }
  content Json @default("{}")

  // Styling overrides
  styles Json? // { backgroundColor, textColor, padding, animation }

  // Position & visibility
  order     Int     @default(0)
  isVisible Boolean @default(true)

  // Responsive options
  hideOnMobile  Boolean @default(false)
  hideOnDesktop Boolean @default(false)

  // Animation
  animation String? // "fade-in", "slide-up", "parallax"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site MusicianSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  page SitePage?    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([siteId, pageId, order])
  @@index([type])
}

enum SectionType {
