model MerchProduct {
  id     String @id @default(cuid())
  siteId String

  // Product Info
  name        String
  description String? @db.Text
  slug        String // URL-friendly name

  // Pricing
  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2) // Original price for "on sale" display
  currency     String   @default("USD")

  // Inventory
  sku               String?
  trackInventory    Boolean @default(false)
  quantity          Int     @default(0)
  lowStockThreshold Int     @default(5)

  // Product Type
  productType MerchProductType @default(physical)

  // Digital Delivery (for digital products)
  digitalUrl String? // URL to digital file

  // Images
  images Json // Array of image URLs

  // Variants (size, color, etc.)
  hasVariants Boolean @default(false)
  variants    Json? // [{ name: "Size", options: ["S", "M", "L"], prices: {...} }]

  // Categories/Tags
  category String? // "apparel", "music", "accessories"
  tags     String[]

  // Status
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  // Shipping
  weight        Decimal? @db.Decimal(10, 2) // in oz or kg
  shippingClass String? // "standard", "heavy", "fragile"

  // SEO
  metaTitle       String?
  metaDescription String?

  // Stats
  viewCount Int @default(0)
  soldCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  site       MusicianSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  orderItems MerchOrderItem[]

  @@unique([siteId, slug])
  @@index([siteId, isActive])
  @@index([siteId, category])
  @@index([siteId, isFeatured])
}

enum MerchProductType {
  physical
  digital
  bundle
}

model MerchOrder {
  id          String @id @default(cuid())
  siteId      String
  orderNumber String @unique // e.g., "ORD-123456"

  // Customer Info
  customerEmail String
  customerName  String

  // Billing Address
  billingAddress Json // { line1, line2, city, state, zip, country }

  // Shipping Address (for physical products)
  shippingAddress Json? // { line1, line2, city, state, zip, country }
  shippingMethod  String? // "standard", "express", "overnight"
  shippingCost    Decimal? @db.Decimal(10, 2)
  trackingNumber  String?
  trackingUrl     String?

  // Payment
  subtotal Decimal @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  // Stripe
  stripePaymentIntentId String? @unique
  stripeChargeId        String?

  // Status
  status        MerchOrderStatus @default(pending)
  paymentStatus PaymentStatus    @default(pending)

  // Dates
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  canceledAt  DateTime?
  refundedAt  DateTime?

  // Notes
  customerNote String? @db.Text
  internalNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  site  MusicianSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items MerchOrderItem[]

  @@index([siteId, status])
  @@index([siteId, createdAt])
  @@index([customerEmail])
  @@index([stripePaymentIntentId])
}

enum MerchOrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  canceled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

model MerchOrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  // Snapshot of product at time of order
  productName  String
  productImage String?
  variantInfo  Json? // { size: "L", color: "Black" }

  // Pricing
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  total     Decimal @db.Decimal(10, 2)

  // For digital products
  downloadUrl   String?
  downloadCount Int     @default(0)
  maxDownloads  Int     @default(5)

  createdAt DateTime @default(now())

  // Relations
  order   MerchOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product MerchProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

