  merge
  split
}

// Enhanced presence tracking
model PresenceState {
  id          String          @id @default(cuid())
  userId      String
  userName    String
  userEmail   String
  userAvatar  String?
  
  // Location
  channelId   String // where they are
  channelType String // project, song, room
  
  // Activity
  status      PresenceStatus  @default(active)
  activity    String? // "Editing verse 2", "Listening to demo"
  
  // Viewport tracking
  viewport    Json? // { scroll: 100, zoom: 1.2, section: "chorus" }
  
  // Cursor/selection
  cursorPosition Int?
  selection      Json? // { start, end, text }
  
  // Device info
  deviceType  String? // desktop, mobile, tablet
  browser     String?
  
  // Timestamps
  lastActive  DateTime        @default(now())
  joinedAt    DateTime        @default(now())
  
  // Expires after 5 minutes of inactivity
  expiresAt   DateTime
  
  @@unique([userId, channelId])
  @@index([channelId, status])
  @@index([userId])
  @@index([expiresAt])
  @@index([lastActive])
}

enum PresenceStatus {
  active
  idle
  away
  dnd // Do not disturb
  offline
}

// Collaboration analytics and insights
model CollaborationMetrics {
  id          String   @id @default(cuid())
  entityId    String
  entityType  EntityType
  
  // Time-based metrics
  date        DateTime @default(now())
  
  // Activity metrics
  activeUsers     Int      @default(0)
  totalEdits      Int      @default(0)
  totalMessages   Int      @default(0)
  totalVoiceMinutes Int    @default(0)
  totalVideoMinutes Int    @default(0)
  
  // Conflict/resolution metrics
  conflicts       Int      @default(0)
  autoResolved    Int      @default(0)
  manualResolved  Int      @default(0)
  
  // Engagement metrics
  commentsAdded   Int      @default(0)
  commentsResolved Int     @default(0)
  reactionsAdded  Int      @default(0)
  
  // User breakdown
  userMetrics     Json? // { userId: { edits: 10, messages: 5 } }
  
  // Heatmap data
  editHeatmap     Json? // Areas of most activity
  timeHeatmap     Json? // When most activity happens
  
  createdAt       DateTime @default(now())
  
  @@unique([entityId, entityType, date])
  @@index([entityId, entityType])
  @@index([date])
}

// Conflict resolution suggestions (AI-powered)
model ConflictSuggestion {
  id          String           @id @default(cuid())
  sessionId   String
  conflictId  String           @unique
  
  // Conflict details
  field       String
  user1Id     String
  user1Value  String           @db.Text
  user2Id     String
  user2Value  String           @db.Text
  
  // AI suggestion
  suggestion  String           @db.Text
  confidence  Float // 0-1
  reasoning   String?          @db.Text
  
  // Resolution
  status      ConflictStatus   @default(pending)
  resolvedBy  String?
  resolution  String? // "accepted_ai", "accepted_user1", "accepted_user2", "manual_merge"
  finalValue  String?          @db.Text
  
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?
  
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
}

enum ConflictStatus {
  pending
  reviewing
  resolved
  ignored
}

