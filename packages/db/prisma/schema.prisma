generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  image             String?
  pro               String?  // ASCAP, BMI, SESAC, None
  mlcMember         Boolean  @default(false)
  soundExchangeRegistered Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  memberships       Membership[]
  subscriptions    Subscription[]
  collaborationRequests CollaborationRequest[]
  collaborationResponses CollaborationResponse[]
  musicianProfile  MusicianProfile?
  skills          Skill[]
  forumPosts      ForumPost[]
  forumReplies    ForumReply[]
  sentMessages    Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  connections     Connection[] @relation("UserConnections")
  connectedTo     Connection[] @relation("ConnectedToUser")
  uploadedAssets  Asset[]
  studioSessions  StudioSession[]
  sessionAttendances SessionAttendee[]
  orgInvites      OrgInvite[]
  assetShares     AssetShare[]
  songSplits      SongSplit[]

  @@index([email])
}

model Org {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  type        OrgType
  brandColor  String?       // Hex color
  description String?
  website     String?
  bio         String?       // Extended biography
  location    String?       // City, State/Country
  genre       String[]      // Musical genres
  influences  String[]      // Musical influences
  founded     Int?          // Year founded
  socialLinks Json?         // { twitter, instagram, facebook, youtube, tiktok, etc }
  contactEmail String?
  bookingEmail String?
  pressKitUrl String?       // Link to downloadable press kit
  epkData     Json?         // Electronic Press Kit data
  achievements Json?        // Notable achievements/milestones
  spotifyArtistId String?
  appleMusicId String?
  images      Json?         // { hero, profile, gallery: [...] }
  verified    Boolean      @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  memberships Membership[]
  projects    Project[]     @relation(name: "OrgProjects")
  events      Event[]
  episodes    PodcastEpisode[]
  tours       Tour[]
  shows       Show[]
  bandMembers BandMember[]
  pressReleases PressRelease[]
  awards      Award[]
  orgInvites  OrgInvite[]

  @@index([slug])
  @@index([type])
  @@index([genre])
  @@index([location])
}

model Membership {
  userId    String
  orgId     String
  role      OrgRole
  status    String    @default("active") // active, inactive, suspended
  user      User @relation(fields: [userId], references: [id])
  org       Org  @relation(fields: [orgId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, orgId])
  @@index([orgId])
}

enum OrgType {
  foundation
  studio
  band
}

enum OrgRole {
  owner
  admin
  member
}

model Project {
  id          String             @id @default(cuid())
  orgId       String
  name        String
  slug        String             @unique
  description String?
  tagline     String?
  coverImage  String?
  visibility  ProjectVisibility  @default(private)
  status      ProjectStatus      @default(active)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  org         Org                @relation(fields: [orgId], references: [id], name: "OrgProjects")
  songs       Song[]
  assets      Asset[]
  splitSheets SplitSheet[]
  licenses    License[]
  events      Event[]
  shows       Show[]
  studioSessions StudioSession[]
  transactions Transaction[]

  @@index([orgId])
  @@index([slug])
  @@index([visibility, status])
}

enum ProjectVisibility {
  private
  org
  public
}

enum ProjectStatus {
  active
  archived
  draft
}

model Song {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  key         String?
  tempo       Int?
  timeSignature String? // e.g., "4/4", "3/4"
  iswc        String?  @unique // International Standard Musical Work Code
  description String?
  lyrics      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  setlistItems SetlistItem[]
  songSplits   SongSplit[]
  transactions Transaction[]

  @@index([projectId])
  @@index([iswc])
}

model Asset {
  id            String      @id @default(cuid())
  projectId     String?
  name          String
  mimeType      String
  fileType      String?     // Additional file type field
  bytes         BigInt      // File size in bytes
  size          Int?        // Size in bytes as Int
  version       Int         @default(1)
  storageKey    String      @unique // S3/R2 key
  storageBucket String?
  checksum      String      // SHA-256
  duration      Float?      // For audio/video, in seconds
  sampleRate    Int?        // For audio, in Hz
  width         Int?        // For images/video
  height        Int?        // For images/video
  metadata      Json?       // Additional extracted metadata
  assetType     AssetType
  uploadedAt    DateTime    @default(now()) // Upload timestamp
  uploadedById  String?     // User who uploaded
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  project       Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  assetShares   AssetShare[]

  @@index([projectId])
  @@index([assetType])
  @@index([storageKey])
  @@index([checksum])
  @@index([uploadedById])
}

enum AssetType {
  audio
  lyric
  image
  pdf
  chart
  video
  other
}

model SplitSheet {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  finalized   Boolean          @default(false)
  finalizedAt DateTime?
  pdfKey      String?          // Storage key for generated PDF
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contributors SplitContributor[]

  @@index([projectId])
  @@index([finalized])
}

model SplitContributor {
  id          String     @id @default(cuid())
  splitSheetId String
  name        String
  role        String?    // e.g., "Writer", "Producer", "Publisher"
  percentage  Float      // 0-100
  pro         String?    // ASCAP, BMI, SESAC, etc.
  ipi         String?    // International Performer Identification
  publisher   String?
  email       String?
  finalized   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  splitSheet  SplitSheet @relation(fields: [splitSheetId], references: [id], onDelete: Cascade)

  @@index([splitSheetId])
}

model License {
  id            String        @id @default(cuid())
  projectId     String
  template      LicenseTemplate
  title         String
  terms         String?       // Custom terms override
  notes         String?
  status        LicenseStatus @default(draft)
  signedAt      DateTime?
  countersignedAt DateTime?
  pdfKey        String?       // Storage key for signed PDF
  signerEmail   String?
  signerName    String?
  countersignerEmail String?
  countersignerName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([template])
}

enum LicenseTemplate {
  COLLAB_NDA
  WORK_FOR_HIRE
  NON_EXCLUSIVE_COLLAB
  PODCAST_MUSIC_LICENSE
  EXCLUSIVE_LICENSE
  MASTER_USE
  SYNCHRONIZATION
}

enum LicenseStatus {
  draft
  pending_signature
  pending_countersignature
  executed
  expired
  cancelled
}

model Event {
  id          String      @id @default(cuid())
  projectId   String?
  orgId       String?
  name        String
  slug        String      @unique
  description String?
  eventType   EventType
  startDate   DateTime
  endDate     DateTime?
  venue       String?
  venueAddress String?
  city        String?
  state       String?
  country     String?
  lineup      Json?       // Array of artist/band names
  ticketUrl   String?
  coverImage  String?
  public      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  org         Org?        @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId])
  @@index([eventType])
  @@index([startDate])
  @@index([slug])
}

enum EventType {
  festival
  concert
  showcase
  workshop
  other
}

model PodcastEpisode {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  slug        String   @unique
  description String?
  showNotes   String?  // Markdown
  audioKey    String?  // Storage key for audio file
  duration    Float?   // In seconds
  publishedAt DateTime?
  guests      Json?    // Array of { name, role, bio }
  tags        String[] // Array of tags
  public      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([publishedAt])
  @@index([slug])
  @@index([public])
}

model Donation {
  id            String         @id @default(cuid())
  amount        Decimal        // In dollars
  currency      String         @default("USD")
  donorName     String?
  donorEmail    String?
  donorAnonymous Boolean       @default(false)
  message       String?
  paymentId     String?       // Give Lively/Stripe payment ID
  status        DonationStatus @default(pending)
  processedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([paymentId])
}

enum DonationStatus {
  pending
  completed
  failed
  refunded
}


enum SubscriptionTier {
  sustaining
  patron
  benefactor
}

enum SubscriptionStatus {
  active
  cancelled
  past_due
  trialing
  incomplete
}

model Subscription {
  id            String           @id @default(cuid())
  userId        String?
  email         String
  tier          SubscriptionTier
  amount        Decimal          // Monthly amount
  currency      String           @default("USD")
  stripeId      String?         @unique // Stripe subscription ID
  status        SubscriptionStatus @default(active)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean     @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User?            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([stripeId])
}

// Tour Management Models

model Tour {
  id            String     @id @default(cuid())
  orgId         String
  name          String
  slug          String     @unique
  description   String?
  startDate     DateTime
  endDate       DateTime?
  status        TourStatus @default(planning)
  posterImage   String?
  sponsorLogos  Json?      // Array of { name, logoUrl, website }
  merch         Json?      // Array of { name, price, image, url }
  public        Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  org           Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shows         Show[]
  fanEngagements FanEngagement[]

  @@index([orgId])
  @@index([status])
  @@index([startDate])
}

enum TourStatus {
  planning
  announced
  ongoing
  completed
  cancelled
}

model Venue {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  type              VenueType @default(club)
  capacity          Int?
  address           String?
  city              String?
  state             String?
  country           String?
  postalCode        String?
  latitude          Float?
  longitude         Float?
  phone             String?
  email             String?
  website           String?
  parkingInfo       String?
  accessibilityInfo String?
  images            Json?     // Array of image URLs
  socialLinks       Json?     // { twitter, instagram, facebook, etc }
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  shows             Show[]

  @@index([city])
  @@index([type])
}

enum VenueType {
  club
  theater
  arena
  stadium
  festival
  other
}

model Show {
  id              String      @id @default(cuid())
  tourId          String?
  orgId           String
  projectId       String?
  venueId         String?
  name            String
  slug            String      @unique
  description     String?
  date            DateTime
  doorsTime       DateTime?
  soundcheckTime  DateTime?
  setLength       Int?        // In minutes
  status          ShowStatus  @default(scheduled)
  ticketUrl       String?
  ticketPrice     Json?       // { general: 25, vip: 50, etc }
  ageRestriction  String?
  supportingActs  Json?       // Array of { name, website, setTime }
  notes           String?     // Internal notes
  posterImage     String?
  livestreamUrl   String?
  recordingUrl    String?
  attendance      Int?
  grossRevenue    Decimal?
  public          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  tour            Tour?       @relation(fields: [tourId], references: [id], onDelete: SetNull)
  org             Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project         Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  venue           Venue?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  setlist         Setlist?
  fanEngagements  FanEngagement[]

  @@index([tourId])
  @@index([orgId])
  @@index([venueId])
  @@index([date])
  @@index([status])
}

enum ShowStatus {
  scheduled
  soldout
  cancelled
  postponed
  completed
}

model Setlist {
  id          String         @id @default(cuid())
  showId      String         @unique
  name        String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  show        Show           @relation(fields: [showId], references: [id], onDelete: Cascade)
  items       SetlistItem[]
}

model SetlistItem {
  id          String    @id @default(cuid())
  setlistId   String
  songId      String?
  position    Int
  notes       String?
  duration    Int?      // In seconds
  isEncore    Boolean   @default(false)
  customTitle String?   // For covers or unreleased songs
  
  setlist     Setlist   @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  song        Song?     @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([setlistId])
  @@index([songId])
}

model FanEngagement {
  id           String    @id @default(cuid())
  showId       String?
  tourId       String?
  email        String
  name         String?
  notifyShows  Boolean   @default(true)
  notifyMerch  Boolean   @default(false)
  location     String?   // City/State for tour routing
  createdAt    DateTime  @default(now())
  
  show         Show?     @relation(fields: [showId], references: [id], onDelete: SetNull)
  tour         Tour?     @relation(fields: [tourId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([showId])
  @@index([tourId])
}

model BandMember {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  role        String    // e.g., "Lead Vocals", "Guitar", "Drums"
  bio         String?
  image       String?
  instruments String[]
  socialLinks Json?     // { twitter, instagram, etc }
  joinedAt    DateTime?
  active      Boolean   @default(true)
  order       Int       @default(0) // Display order
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model PressRelease {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  slug        String    @unique
  content     String    // Markdown content
  excerpt     String?
  publishedAt DateTime?
  attachments Json?     // Array of { name, url, type }
  public      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([publishedAt])
}

model Award {
  id              String    @id @default(cuid())
  orgId           String
  name            String    // e.g., "Grammy Award"
  organization    String    // e.g., "The Recording Academy"
  year            Int
  category        String?   // e.g., "Best New Artist"
  description     String?
  image           String?
  verificationUrl String?
  createdAt       DateTime  @default(now())
  
  org             Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([year])
}

// Community Features

model CollaborationRequest {
  id          String               @id @default(cuid())
  userId      String
  title       String
  slug        String               @unique
  description String
  projectType String
  genre       String[]
  skillsNeeded String[]
  location    String?
  isRemote    Boolean              @default(true)
  isPaid      Boolean              @default(false)
  compensation String?
  deadline    DateTime?
  status      CollaborationStatus  @default(open)
  viewCount   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses   CollaborationResponse[]

  @@index([userId])
  @@index([status])
  @@index([genre])
  @@index([skillsNeeded])
}

enum CollaborationStatus {
  open
  in_progress
  completed
  cancelled
}

model CollaborationResponse {
  id          String    @id @default(cuid())
  requestId   String
  userId      String
  message     String
  portfolio   String?
  accepted    Boolean?
  createdAt   DateTime  @default(now())
  
  request     CollaborationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([userId])
}

model MusicianProfile {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  instruments              String[]
  genres                   String[]
  skills                   String[]
  experience               String?
  availableForCollaboration Boolean  @default(true)
  availableForGigs         Boolean  @default(false)
  hourlyRate               Decimal?
  location                 String?
  willingToTravel          Boolean  @default(false)
  travelRadius             Int?     // In miles/km
  portfolio                Json?    // Links to work samples
  socialLinks              Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([genres])
  @@index([instruments])
  @@index([availableForCollaboration])
}

model Skill {
  id              String      @id @default(cuid())
  userId          String
  category        String      // e.g., "Instrument", "Production", "Songwriting"
  name            String      // e.g., "Guitar", "Mixing", "Lyrics"
  level           SkillLevel
  yearsExperience Int?
  description     String?
  verified        Boolean     @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([level])
}

enum SkillLevel {
  beginner
  intermediate
  advanced
  professional
}

model ForumPost {
  id          String         @id @default(cuid())
  userId      String
  title       String
  slug        String         @unique
  content     String         // Markdown
  category    ForumCategory
  tags        String[]
  isPinned    Boolean        @default(false)
  isLocked    Boolean        @default(false)
  viewCount   Int            @default(0)
  upvotes     Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     ForumReply[]

  @@index([userId])
  @@index([category])
  @@index([tags])
}

enum ForumCategory {
  general
  collaboration
  feedback
  showcase
  technical
  business
  events
}

model ForumReply {
  id               String       @id @default(cuid())
  postId           String
  userId           String
  parentId         String?
  content          String       // Markdown
  upvotes          Int          @default(0)
  isAcceptedAnswer Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  
  post             ForumPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent           ForumReply?  @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: SetNull)
  children         ForumReply[] @relation("ReplyToReply")

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model Message {
  id           String    @id @default(cuid())
  senderId     String
  recipientId  String
  subject      String?
  content      String
  isRead       Boolean   @default(false)
  readAt       DateTime?
  threadId     String?   // For grouping conversations
  attachments  Json?     // Array of { name, url, type }
  createdAt    DateTime  @default(now())
  
  sender       User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([threadId])
  @@index([isRead])
}

model Connection {
  id              String    @id @default(cuid())
  userId          String
  connectedUserId String
  status          String    @default("pending") // pending, accepted, blocked
  message         String?   // Connection request message
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?
  
  user            User      @relation("UserConnections", fields: [userId], references: [id], onDelete: Cascade)
  connectedUser   User      @relation("ConnectedToUser", fields: [connectedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, connectedUserId])
  @@index([userId])
  @@index([connectedUserId])
  @@index([status])
}

// Studio Session Management
model StudioSession {
  id              String      @id @default(cuid())
  projectId       String
  title           String
  type            String      // writing, recording, meeting, rehearsal
  status          String      @default("scheduled") // scheduled, in_progress, completed, cancelled
  startTime       DateTime
  endTime         DateTime
  location        String?
  notes           String?
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User        @relation(fields: [createdById], references: [id])
  attendees       SessionAttendee[]

  @@index([projectId])
  @@index([startTime])
  @@index([createdById])
}

model SessionAttendee {
  id              String          @id @default(cuid())
  sessionId       String
  userId          String
  role            String          @default("participant") // organizer, participant
  status          String          @default("invited") // invited, confirmed, declined
  createdAt       DateTime        @default(now())
  
  session         StudioSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

// Organization Invites
model OrgInvite {
  id              String      @id @default(cuid())
  orgId           String
  code            String      @unique
  maxUses         Int?
  uses            Int         @default(0)
  expiresAt       DateTime
  createdById     String
  createdAt       DateTime    @default(now())
  
  org             Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy       User        @relation(fields: [createdById], references: [id])

  @@index([orgId])
  @@index([code])
  @@index([expiresAt])
}

// Asset Sharing
model AssetShare {
  id              String      @id @default(cuid())
  assetId         String
  shareCode       String      @unique
  expiresAt       DateTime?
  password        String?
  maxDownloads    Int?
  downloads       Int         @default(0)
  accessType      String      @default("view") // view, download
  createdById     String
  createdAt       DateTime    @default(now())
  
  asset           Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy       User        @relation(fields: [createdById], references: [id])

  @@index([assetId])
  @@index([shareCode])
  @@index([expiresAt])
}

// Song Splits for Revenue
model SongSplit {
  id              String      @id @default(cuid())
  songId          String
  userId          String
  percentage      Float       // 0-100
  role            String      // writer, producer, performer
  confirmed       Boolean     @default(false)
  confirmedAt     DateTime?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  song            Song        @relation(fields: [songId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id])

  @@unique([songId, userId])
  @@index([songId])
  @@index([userId])
}

// Financial Transactions
model Transaction {
  id              String              @id @default(cuid())
  songId          String?
  projectId       String?
  amount          Decimal             @db.Decimal(10, 2)
  currency        String              @default("USD")
  type            TransactionType
  status          TransactionStatus   @default(pending)
  description     String?
  metadata        Json?
  processedAt     DateTime?
  createdAt       DateTime            @default(now())
  
  song            Song?               @relation(fields: [songId], references: [id], onDelete: SetNull)
  project         Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([songId])
  @@index([projectId])
  @@index([type])
  @@index([status])
}

enum TransactionType {
  streaming_royalty
  performance_royalty
  mechanical_royalty
  sync_license
  merchandise
  ticket_sales
  donation
  other
}

enum TransactionStatus {
  pending
  processing
  completed
  failed
  cancelled
}
