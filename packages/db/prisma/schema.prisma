// SOCIAL FEED - Facebook/X.com/SoundCloud hybrid
// ====================================

model Post {
  id          String  @id @default(cuid())
  userId      String
  content     String? @db.Text
  contentType String  @default("text") // text, audio, image, video, link

  // Audio posts (SoundCloud-style)
  audioUrl     String?
  audioPath    String?
  waveformData Json?
  duration     Int? // in seconds
  bpm          Int?
  key          String? // Musical key (C, Am, etc.)

  // Media attachments
  imageUrls   String[]
  videoUrl    String?
  linkUrl     String?
  linkPreview Json? // Open Graph preview data

  // Metadata
  genre String?
  mood  String?
  tags  String[]

  // Privacy & permissions
  visibility     String  @default("public") // public, friends, private
  allowComments  Boolean @default(true)
  allowReactions Boolean @default(true)
  allowShares    Boolean @default(true)

  // Engagement metrics (cached for performance)
  likeCount    Int @default(0)
  commentCount Int @default(0)
  shareCount   Int @default(0)
  playCount    Int @default(0)

  // Repost tracking
  originalPostId   String? // For reposts/shares
  sharedFromUserId String? // Original author for reposts

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  // Relations
  author       User  @relation("AuthoredPosts", fields: [userId], references: [id], onDelete: Cascade)
  originalPost Post? @relation("PostShares", fields: [originalPostId], references: [id], onDelete: SetNull)
  sharedFrom   User? @relation("SharedPosts", fields: [sharedFromUserId], references: [id], onDelete: SetNull)

  reposts   Post[]         @relation("PostShares")
  reactions PostReaction[]
  shares    PostShare[]
  comments  PostComment[]
  plays     PostPlay[]
  bookmarks PostBookmark[]

  @@index([userId])
  @@index([originalPostId])
  @@index([sharedFromUserId])
  @@index([visibility])
  @@index([contentType])
  @@index([createdAt(sort: Desc)])
  @@index([genre])
  @@index([mood])
  @@index([isDeleted])
}

