{
  "name": "@cronkwaters/db",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "prisma"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./prisma": "./prisma/schema.prisma"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --name init_schema",
    "build": "prisma generate",
    "build:full": "prisma generate && tsc -b",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cronkwaters/config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^9.12.0",
    "typescript": "^5.6.3"
  }
}
