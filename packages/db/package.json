{
  "name": "@cronkwaters/db",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "prisma"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./prisma": "./prisma/schema.prisma"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "build": "pnpm prisma:generate && tsc -b",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "prisma": "^5.20.0"
  },
  "devDependencies": {
    "@cronkwaters/config": "workspace:*",
    "eslint": "^9.12.0",
    "typescript": "^5.6.3"
  }
}

