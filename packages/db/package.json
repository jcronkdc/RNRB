{
  "name": "@cronkwaters/db",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "prisma"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./prisma": "./prisma/schema.prisma"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --name init_schema",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "build:full": "prisma generate && tsc -b",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^7.4.1",
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "dotenv": "^17.2.3",
    "pg": "^8.18.0",
    "prisma": "^7.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cronkwaters/config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^9.12.0",
    "typescript": "^5.6.3"
  }
}
