{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "OPENAI_API_KEY",
    "XAI_API_KEY",
    "XAI_RATE_LIMIT_RPM",
    "XAI_RATE_LIMIT_TPM"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "dependsOn": ["^dev"]
    },
    "build": {
      "dependsOn": ["^build", "@songforge/db#prisma:generate"],
      "outputs": [
        "dist/**",
        ".next/**",
        "storybook-static/**"
      ]
    },
    "prisma:generate": {
      "cache": false,
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["@songforge/db#prisma:generate"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": []
    }
  }
}
