{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "OPENAI_API_KEY",
    "XAI_API_KEY",
    "XAI_RATE_LIMIT_RPM",
    "XAI_RATE_LIMIT_TPM"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "dependsOn": ["^dev"]
    },
    "build": {
      "dependsOn": ["^build", "@cronkwater/db#prisma:generate"],
      "outputs": [
        "dist/**",
        ".next/**",
        "storybook-static/**"
      ],
      "env": [
        "DATABASE_URL",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "OPENAI_API_KEY",
        "XAI_API_KEY",
        "XAI_RATE_LIMIT_RPM",
        "XAI_RATE_LIMIT_TPM",
        "NEXT_PUBLIC_SITE_URL",
        "EMAIL_SERVER_URL",
        "EMAIL_FROM",
        "NEXT_TELEMETRY_DISABLED"
      ]
    },
    "prisma:generate": {
      "cache": false,
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["@cronkwater/db#prisma:generate"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": []
    }
  }
}
