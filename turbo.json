{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "NODE_ENV",
    "ABLY_API_KEY",
    "DAILY_API_KEY"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "dependsOn": ["^dev"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**"
      ],
      "env": [
        "DATABASE_URL",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "AUTH0_CLIENT_ID",
        "AUTH0_CLIENT_SECRET",
        "AUTH0_DOMAIN",
        "AUTH0_ISSUER_BASE_URL",
        "AUTH0_BASE_URL",
        "AUTH0_SECRET",
        "OPENAI_API_KEY",
        "XAI_API_KEY",
        "XAI_RATE_LIMIT_RPM",
        "XAI_RATE_LIMIT_TPM",
        "STRIPE_SECRET_KEY",
        "EMAIL_SERVER_URL",
        "EMAIL_FROM",
        "EMAIL_PROVIDER",
        "FROM_EMAIL",
        "ELEVENLABS_API_KEY",
        "RESEND_API_KEY",
        "MXBAI_API_KEY",
        "MXBAI_STORE_ID",
        "AUTH_TRUST_HOST",
        "NEON_PROJECT_ID",
        "APP_BASE_URL",
        "ABLY_API_KEY",
        "DAILY_API_KEY",
        "POSTGRES_URL",
        "POSTGRES_PRISMA_URL",
        "DATABASE_URL_UNPOOLED",
        "POSTGRES_URL_NON_POOLING",
        "POSTGRES_URL_NO_SSL",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD",
        "POSTGRES_DATABASE",
        "POSTGRES_HOST",
        "PGHOST",
        "PGHOST_UNPOOLED",
        "PGUSER",
        "PGPASSWORD",
        "PGDATABASE",
        "DEMO_BYPASS",
        "VITE_STRIPE_PUBLISHABLE_KEY",
        "STACK_SECRET_SERVER_KEY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}

